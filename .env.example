# App connection — a non-superuser role, so Postgres row-level security is enforced.
DATABASE_URL=postgres://docmind_app:docmind_app@localhost:5434/docmind
# Owner connection — only for migrations and seeding.
DATABASE_ADMIN_URL=postgres://docmind:docmind@localhost:5434/docmind

# Answer cache (docker-compose.yml). Leave empty to disable caching.
REDIS_URL=redis://localhost:6380

# Session cookie signing key — generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Local embeddings via Ollama (brew services start ollama; ollama pull nomic-embed-text)
OLLAMA_URL=http://localhost:11434
EMBED_MODEL=nomic-embed-text

# Chat model. "groq" uses the free Groq API (https://console.groq.com/keys);
# "ollama" runs a small local model instead (ollama pull qwen2.5:1.5b).
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
